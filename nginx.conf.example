server {
    listen 80;
    server_name roomdoku.seudominio.com;

    # Após configurar SSL com Certbot, o Certbot adiciona automaticamente o bloco listen 443 ssl.
    # O HTTPS é obrigatório para que Android/iOS liberem a instalação como App (PWA).

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # Suporte obrigatório para WebSocket (Socket.IO)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 86400;
    }
}
